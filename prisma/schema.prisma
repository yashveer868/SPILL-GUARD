generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IncidentStatus {
  NEW
  INVESTIGATING
  CONFIRMED
  DISMISSED
  RESOLVED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentSource {
  SAR
  MANUAL
  DEMO
  API
}

model Vessel {
  id          String        @id @default(cuid())
  imoNumber   String?       @unique
  mmsi        String?       @unique
  vesselName  String
  flag        String?
  vesselType  String?
  status      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  incidents   Incident[]
  aisPositions AisPosition[]
}

model Incident {
  id                String           @id @default(cuid())
  incidentCode      String           @unique
  title             String
  status            IncidentStatus   @default(NEW)
  severity          IncidentSeverity
  confidenceScore   Float?
  detectedAt        DateTime
  latitude          Float
  longitude         Float
  estimatedAreaKm2  Float?
  source            IncidentSource   @default(API)
  summary           String
  vesselId          String?
  vessel            Vessel?          @relation(fields: [vesselId], references: [id], onDelete: SetNull)
  alertEvents       AlertEvent[]
  evidence          Evidence[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([detectedAt])
  @@index([status])
  @@index([severity])
  @@index([latitude, longitude])
}

model AisPosition {
  id             String   @id @default(cuid())
  vesselId       String
  vessel         Vessel   @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  latitude       Float
  longitude      Float
  speedKnots     Float?
  courseDegrees  Float?
  recordedAt     DateTime
  createdAt      DateTime @default(now())

  @@index([vesselId, recordedAt])
}

model AlertEvent {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  eventType  String
  message    String
  actor      String
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
}

model Evidence {
  id           String   @id @default(cuid())
  incidentId   String
  incident     Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  evidenceType String
  fileUrl      String?
  sha256Hash   String?
  metadataJson Json
  createdAt    DateTime @default(now())

  @@index([incidentId, createdAt])
}
